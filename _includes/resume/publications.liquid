{% assign publication_groups = 'published:Published or accepted|under_review:In the peer-review process|working_paper:Working papers' | split: '|' %}
{% for group in publication_groups %}
  {% assign group_status = group | split: ':' | first %}
  {% assign group_title = group | split: ':' | last %}
  {% assign publications = data[1] | where: 'status', group_status | sort: 'releaseDate' | reverse %}
  {% if publications.size == 0 %} {% continue %} {% endif %}
<h5 class="font-weight-medium mt-3 mb-2">{{ group_title }}</h5>
<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in publications %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-12 col-sm-3 col-md-2 text-center date-column">
          {% if content.releaseDate %} {% assign date = content.releaseDate | split: '-' | join: '.' %} {% else %} {% assign date = '' %} {% endif %}
          <table class="table-cv">
            <tbody>
              <tr>
                <td>
                  <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">{{ date }}</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="col-12 col-sm-9 col-md-10 mt-2 mt-sm-0 details-column">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            {% if content.url and content.url != '' %} 
              <a href="{{ content.url }}">{{ content.name }}</a> 
            {% else %}
              {{ content.name }}
            {% endif %}
          </h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ content.authors }} </h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem"><strong>{{ content.publisher }}</strong></h6>
          {% if content.summary and content.summary != '' %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic"><i class="fa fa-award"></i> {{ content.summary }}</h6>
          {% endif %}        
          </div>
      </div>
    </li>
  {% endfor %}
</ul>
{% endfor %}
